#version 450
// BabelStream-style copy: c = a. Grid-stride loop so any element count works with a fixed dispatch.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer A { vec4 a[]; };
layout(std430, binding = 1) writeonly buffer C { vec4 c[]; };
layout(push_constant) uniform PC { uint n; } pc;
void main() {
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += stride) c[i] = a[i];
}
