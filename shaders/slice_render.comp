#version 450
#extension GL_GOOGLE_include_directive : require
#include "fdtd_params.h"
// Slice view: one pixel per invocation. Re{X exp(j phase)} from the phasors at the four nodes around the
// pixel, bilinear between them, through the diverging colour map; the copper mask and the letterbox as in
// renderFrame (src/viz/slice.cpp), which the GPU test compares with.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Params { SliceParams p; };
layout(std430, binding = 1) readonly buffer Re { float re[]; };
layout(std430, binding = 2) readonly buffer Im { float im[]; };
layout(std430, binding = 3) readonly buffer Mask { uint mask[]; };
// (node or 0xffffffff outside the plane, lower node, fraction as float bits): width columns, then rows
layout(std430, binding = 4) readonly buffer Tables { uvec4 tab[]; };
layout(std430, binding = 5) writeonly buffer Out { uint rgb[]; };
layout(push_constant) uniform PC { uint pixels; } pc;

float byteOf(float v) { return floor(clamp(v, 0.0, 255.0) + 0.5); }

float fieldAt(uint i, uint j) {
  const uint n = i + p.nu * j;
  return re[n] * p.cosPhase - im[n] * p.sinPhase;
}

vec3 mapLight(float value) {
  const float t = clamp(value, -1.0, 1.0);
  const float a = pow(abs(t), p.gamma);
  const vec3 e = t >= 0.0 ? p.positive.xyz : p.negative.xyz;
  const vec3 mid = mix(vec3(250.0), e, 0.5);
  const vec3 c = a < 0.5 ? mix(vec3(250.0), mid, a / 0.5) : mix(mid, e, (a - 0.5) / 0.5);
  return vec3(byteOf(c.x), byteOf(c.y), byteOf(c.z));
}

vec3 mapDark(float value) {
  const float t = clamp(value, -1.0, 1.0);
  const float a = pow(abs(t), p.gamma);
  const vec3 b = t >= 0.0 ? p.positive.xyz : p.negative.xyz;
  const vec3 zero = vec3(8.0, 8.0, 14.0), mid = b * 0.75, end = mix(b, vec3(255.0), 0.4);
  const vec3 c = a < 0.5 ? mix(zero, mid, a / 0.5) : mix(mid, end, (a - 0.5) / 0.5);
  return vec3(byteOf(c.x), byteOf(c.y), byteOf(c.z));
}

void main() {
  const bool light = (p.flags & SLICE_LIGHT) != 0u;
  for (uint pix = gl_GlobalInvocationID.x; pix < pc.pixels; pix += gl_NumWorkGroups.x * 64u) {
    const uint x = pix % p.width, y = pix / p.width;
    const uvec4 col = tab[x], row = tab[p.width + y];
    vec3 c = light ? vec3(238.0, 238.0, 241.0) : vec3(20.0, 20.0, 24.0);
    if (col.x != 0xffffffffu && row.x != 0xffffffffu) {
      if ((p.flags & SLICE_MASK) != 0u && mask[col.x + p.nu * row.x] != 0u) {
        c = light ? vec3(70.0, 70.0, 82.0) : vec3(110.0, 110.0, 110.0);
      } else {
        const uint i0 = col.y, j0 = row.y;
        const uint i1 = min(i0 + 1u, p.nu - 1u), j1 = min(j0 + 1u, p.nv - 1u);
        const float tx = uintBitsToFloat(col.z), ty = uintBitsToFloat(row.z);
        const float v = mix(mix(fieldAt(i0, j0), fieldAt(i1, j0), tx), mix(fieldAt(i0, j1), fieldAt(i1, j1), tx), ty);
        const float s = v / p.colourScale;
        c = light ? mapLight(s) : mapDark(s);
      }
    }
    rgb[pix] = uint(c.x) | (uint(c.y) << 8) | (uint(c.z) << 16);
  }
}
